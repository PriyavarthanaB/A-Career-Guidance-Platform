        <mxCell id="edge_p2_p3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="server_box" source="proc2" target="proc3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_p3_p4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="server_box" source="proc3" target="proc4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_p2_ext" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=1.5;startArrow=classic;startFill=1;" edge="1" parent="server_box" source="proc2" target="external_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Request Arrow (Client to Server) -->
        <mxCell id="req_arrow" value="Request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontStyle=1;fontSize=12;fontColor=#2563eb;strokeColor=#2563eb;strokeWidth=2;" edge="1" parent="1" source="user_inputs" target="proc1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Response Arrow (Server to Client) -->
        <mxCell id="resp_arrow" value="Response" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontStyle=1;fontSize=12;fontColor=#16a34a;strokeColor=#16a34a;strokeWidth=2;" edge="1" parent="1" source="proc4" target="user_inputs">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="430" y="433" />
              <mxPoint x="430" y="340" />
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- MongoDB Database Cylinder -->
        <mxCell id="db_box" value="MongoDB Atlas&#xa;Database" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fontStyle=1;fontSize=12;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="1030" y="290" width="110" height="110" as="geometry" />
        </mxCell>
        <!-- Edge Server Proc4 to DB -->
        <mxCell id="edge_proc4_db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;startArrow=classic;startFill=1;" edge="1" parent="1" source="proc4" target="db_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
