' SyntacHire AI sequence diagrams
' Render each @startuml ... @enduml block as an individual diagram.

@startuml SH01_Authentication
title SyntacHire AI - Registration, Login, and Password Recovery
autonumber
actor Candidate
participant "React Client" as Client
participant "Express API" as API
database MongoDB as DB
participant "Email Service" as Email
participant "JWT Service" as JWT

== Email-verified registration ==
Candidate -> Client: Enter name, email, password, target role
Client -> API: POST /api/auth/send-signup-otp
API -> DB: Check existing account; store hashed signup payload and OTP
DB --> API: Account availability and OTP record
API -> Email: Send signup verification code
Email --> Candidate: Verification code email
API --> Client: OTP sent
Candidate -> Client: Enter verification code
Client -> API: POST /api/auth/verify-signup-otp
API -> DB: Find matching unexpired signup OTP
DB --> API: Pending signup payload
alt OTP valid
  API -> DB: Create verified user; delete used OTP
  DB --> API: User created
  API -> JWT: Sign 7-day access token
  JWT --> API: Token
  API --> Client: Token and user profile
  Client --> Candidate: Open authenticated application
else OTP invalid or expired
  API --> Client: Verification error
  Client --> Candidate: Show error and allow resend
end

== Login ==
Candidate -> Client: Enter email and password
Client -> API: POST /api/auth/login
API -> DB: Find user by email
DB --> API: User record and password hash
alt Account exists and password matches
  API -> DB: Update login streak and last login
  DB --> API: Updated user
  API -> JWT: Sign 7-day access token
  JWT --> API: Token
  API --> Client: Token and user profile
  Client --> Candidate: Open authenticated application
else Unknown account or incorrect password
  API --> Client: Invalid-credentials response
  Client --> Candidate: Show login error
end

== Password recovery ==
Candidate -> Client: Request reset using email
Client -> API: POST /api/auth/forgot-password
API -> DB: Find account; store reset OTP
DB --> API: Account and OTP record
API -> Email: Send reset code
Email --> Candidate: Password reset code email
API --> Client: Reset code sent
Candidate -> Client: Submit code and new password
Client -> API: POST /api/auth/reset-password
API -> DB: Find matching reset OTP and account
DB --> API: OTP and account result
alt OTP valid and new password accepted
  API -> DB: Hash and save new password; delete used OTP
  DB --> API: Password updated
  API --> Client: Password reset success
  Client --> Candidate: Return to login
else Invalid or expired OTP / invalid input
  API --> Client: Validation error
  Client --> Candidate: Show recovery error
end
@enduml

@startuml SH02_Account_Settings
title SyntacHire AI - Profile and Account Settings
autonumber
actor Candidate
participant "React Client" as Client
participant "Express API" as API
participant "Auth Middleware" as Auth
database MongoDB as DB
participant "Google Gemini AI" as Gemini

== Update profile ==
Candidate -> Client: Edit profile and target role
Client -> API: PUT /api/auth/profile + Bearer token
API -> Auth: Verify JWT
Auth --> API: Authenticated user ID
API -> DB: Update profile fields
DB --> API: Updated profile
API --> Client: Updated profile data
Client --> Candidate: Show saved profile

== Change password ==
Candidate -> Client: Submit current and new passwords
Client -> API: PUT /api/auth/change-password + Bearer token
API -> Auth: Verify JWT
Auth --> API: Authenticated user ID
API -> DB: Load account and password hash
DB --> API: Account record
alt Current password matches
  API -> DB: Save hash of new password
  DB --> API: Password updated
  API --> Client: Success response
else Current password does not match
  API --> Client: Password validation error
end

== Change target role and reanalyze latest resume ==
Candidate -> Client: Select target role
Client -> API: POST /api/resume/reanalyze-for-role + Bearer token
API -> Auth: Verify JWT
Auth --> API: Authenticated user ID
API -> DB: Update target role and load latest resume text
DB --> API: Latest resume or no resume
alt Resume text exists
  API -> Gemini: Analyze resume for selected target role
  Gemini --> API: ATS score, skills, gaps, suggestions, summary
  API -> DB: Create new resume analysis record
  DB --> API: Saved analysis
  API --> Client: New role-specific analysis
else No resume on file
  API --> Client: Role updated; resume analysis not run
end

== Delete account ==
Candidate -> Client: Confirm account deletion with password
Client -> API: DELETE /api/auth/delete-account + Bearer token
API -> Auth: Verify JWT
Auth --> API: Authenticated user ID
API -> DB: Load account and verify password
DB --> API: Account record
alt Password matches
  API -> DB: Delete resumes, interviews, DSA progress, and user
  DB --> API: Account data deleted
  API --> Client: Deletion success
  Client --> Candidate: Clear token and return to public screen
else Password does not match
  API --> Client: Deletion rejected
end
@enduml

